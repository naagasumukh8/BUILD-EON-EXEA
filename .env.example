# ─── AI (Google Gemini) ───────────────────────────────────────────────
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ─── DATABASE (Supabase) ───────────────────────────────────────────────
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://jzaluzzbjwtyhumcwohc.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── AIS VESSEL TRACKING ──────────────────────────────────────────────
# aisstream.io WebSocket AIS API Key (https://aisstream.io)
AISSTREAM_API_KEY=
AIS_API_KEY=

# ─── ECONOMICS / REFERENCE DATA ───────────────────────────────────────
MARKET_PRICE_USD_PER_BBL=85.00
DEFAULT_MIN_TARGET_MARGIN=0.08
INR_USD_RATE=83.5

# ─── BACKEND SERVER ───────────────────────────────────────────────────
PORT=8000
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,https://build-eon-exea.vercel.app

# ─── PRODUCTION BACKEND DEPLOYMENT ────────────────────────────────────
# URL of the deployed Python FastAPI backend (e.g. Railway, Render, Fly.io)
# This is a SERVER-SIDE variable — it is NOT exposed to the browser.
# When set, the Next.js /api/vessels route will proxy AIS requests to the backend.
# When NOT set, the frontend uses the client-side fallback engine.
BACKEND_API_URL=

# Public URL for the frontend to directly call the backend (optional — used when backend has public REST endpoints)
# This IS exposed to the browser via process.env.NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── VERCEL ENV SETUP NOTES ───────────────────────────────────────────
# Add these in Vercel Dashboard > Project Settings > Environment Variables:
#   AISSTREAM_API_KEY      → server-side only (never NEXT_PUBLIC_ prefix)
#   AIS_API_KEY            → server-side only (never NEXT_PUBLIC_ prefix)
#   BACKEND_API_URL        → server-side only
#   NEXT_PUBLIC_API_URL    → if Python backend has a public URL
#   GEMINI_API_KEY         → server-side only
#   SUPABASE_URL           → can be public
#   SUPABASE_ANON_KEY      → can be public (RLS protected)
#   SUPABASE_SERVICE_KEY   → server-side only (bypasses RLS)
