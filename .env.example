# ─── AI ───────────────────────────────────────────────────────────────
# Google Gemini API key (required for intake parsing, explanation, report)
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use. MUST match an available model name exactly.
# If the model is unavailable, the application raises ConfigError — it does NOT
# silently substitute another model.
GEMINI_MODEL=gemini-2.5-flash

# ─── DATABASE (Supabase) ───────────────────────────────────────────────
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── AIS VESSEL TRACKING ──────────────────────────────────────────────
# aisstream.io WebSocket AIS (free tier, register with GitHub)
# https://aisstream.io
# Without this key, the application uses SIMULATED vessel data (clearly labelled).
AISSTREAM_API_KEY=

# ─── ECONOMICS / REFERENCE DATA ───────────────────────────────────────
# Market selling price for reference P&L calculations (USD per barrel)
# Used in deal evaluator if the user does not supply their own price.
# Labelled SIMULATED in UI.
MARKET_PRICE_USD_PER_BBL=85.00

# Minimum target margin for GO/NEGOTIATE/REJECT thresholds (0.0–1.0)
DEFAULT_MIN_TARGET_MARGIN=0.08

# INR/USD exchange rate for INR display (labelled SIMULATED)
INR_USD_RATE=83.5

# ─── BACKEND SERVER ───────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── FRONTEND ─────────────────────────────────────────────────────────
# Set in frontend/.env.local — backend URL seen by Next.js server
NEXT_PUBLIC_API_URL=http://localhost:8000
