# Maritime Decision Network — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to source control.

# ── AI (required for explanation + report generation) ──
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Or use OpenAI instead:
# OPENAI_API_KEY=

# ── AIS Vessel Tracking (optional — unlocks real vessel positions) ──
# Get a free key at: https://aisstream.io
AISSTREAM_API_KEY=

# ── Map (optional — Leaflet works without a key) ──
# MAPBOX_TOKEN=

# ── Database (optional, for logging optimization runs) ──
# DATABASE_URL=postgresql://user:password@host:5432/maritime

# ── Server ──
PORT=3000
